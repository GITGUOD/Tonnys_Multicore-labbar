            unlock(excess_list_lock)
            print "thread terminating"   // requirement 3
            return

        // Case 2: nothing to do right now, but others still working
        while (excess_list is empty AND threads_active > 0):
            wait(condition_variable, excess_list_lock)
            // after waking: need to re-check both conditions again — why?

        u = pop from excess_list
        threads_active++
        unlock(excess_list_lock)

        discharge(u)   // uses per-node locks internally

        lock(excess_list_lock)
        threads_active--
        notify_all(condition_variable)
        unlock(excess_list_lock)


